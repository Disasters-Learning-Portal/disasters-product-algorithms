# Copernicus Data Space credentials for the Sentinel-2 download step.
#
# SETUP:
#   1. Copy this file to ".env.local" in this same folder (the repo root) or in
#      the folder you launch Jupyter from:
#          cp .env.local.example .env.local
#   2. Fill in your real values below.
#
# ".env.local" is git-ignored, so your credentials are never committed.
#
# WHERE TO GET / MANAGE THESE CREDENTIALS:
#   - Portal:    https://dataspace.copernicus.eu/    (top-right "Login" / "Register")
#   - Register:  https://documentation.dataspace.copernicus.eu/Registration.html
#   - Forgot password / reset: use "Forgot password" on the login page, or manage
#     your account at https://identity.dataspace.copernicus.eu/
#   - COP_USER is the EMAIL you registered with; COP_PASS is that account's password.
#   - These are the same credentials you use to log in to the Copernicus Browser.

COP_USER=you@example.com
COP_PASS=your_password_here
